diff --git a/crates/omega-zero/src/frontend/sync_achievements.rs b/crates/omega-zero/src/frontend/sync_achievements.rs
new file mode 100644
index 0000000..1e8988f
--- /dev/null
+++ b/crates/omega-zero/src/frontend/sync_achievements.rs
@@ -0,0 +1,75 @@
+//! A bounded queue of earned-only notices. Uses Omega's own panel art; never waits on HTTP.
+use std::collections::VecDeque;
+use std::time::{Duration, Instant};
+
+use omega_achievements::{Notice, NoticeKind};
+use omega_gfx::{out_w, Compositor, Draw, TexId};
+use omega_ui::kit::{pixel::quad, toast::toast_face};
+
+use super::faces::upload_nearest;
+use crate::session::Session;
+
+#[derive(Default)]
+pub(super) struct Achievements {
+    pending: VecDeque<Notice>,
+    active: Option<(Instant, u32, u32)>,
+    tex: Option<TexId>,
+}
+
+impl Achievements {
+    pub fn update(&mut self, session: &Session, compositor: &mut Compositor) {
+        while let Some(notice) = session.take_achievement_notice() {
+            if notice.kind == NoticeKind::Earned && self.pending.len() < 16 {
+                self.pending.push_back(notice);
+            }
+        }
+        if self
+            .active
+            .is_some_and(|(at, _, _)| at.elapsed() >= Duration::from_millis(3500))
+        {
+            self.active = None;
+        }
+        if self.active.is_none() {
+            if let Some(notice) = self.pending.pop_front() {
+                let text = notification_text(&notice.title, &notice.detail);
+                let face = toast_face("ACHIEVEMENT UNLOCKED", &text, session.app().palette());
+                upload_nearest(compositor, &mut self.tex, &face);
+                self.active = Some((Instant::now(), face.w, face.h));
+            }
+        }
+    }
+    pub fn draw(&self, draws: &mut Vec<Draw>) {
+        if let (Some((_, w, h)), Some(tex)) = (self.active, self.tex) {
+            draws.push(quad(
+                tex,
+                w,
+                h,
+                (out_w() as f32 - w as f32 * 2.0) / 2.0,
+                8.0,
+            ));
+        }
+    }
+}
+
+fn notification_text(title: &str, detail: &str) -> String {
+    // At 2x, a 46-character line fits the narrowest supported 640-wide test canvas.
+    let text = format!("{title} {detail}");
+    let mut chars = text.chars();
+    let mut out: String = chars.by_ref().take(46).collect();
+    if chars.next().is_some() {
+        out.truncate(out.char_indices().nth(43).map_or(out.len(), |(at, _)| at));
+        out.push_str("...");
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn notification_is_bounded_and_unicode_safe() {
+        let line = notification_text(&"é".repeat(100), "+5 points");
+        assert_eq!(line.chars().count(), 46);
+        assert!(line.ends_with("..."));
+    }
+}
